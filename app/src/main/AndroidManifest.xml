<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility: see speech recognition and TTS services -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Network for HA communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Microphone for STT and wake word -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service for wake word -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock for screen wake on detection -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Biometric authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Full screen intent for wake word detection (brings app to front) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Vibration feedback for wake word detection -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".JarvisApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisHA"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisHA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.MicWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mic_info" />
        </receiver>

        <!--
            Wake word runs in its own dedicated process (":wakeword").

            Rationale: this keeps the lightweight TFLite wake-word listener out of the
            same process as the heavy Sherpa-ONNX/Whisper STT pipeline (~160 MB native
            heap). Previously they shared the main process, so the OS repeatedly killed
            the whole app (including the wake-word listener) under memory pressure.
            Isolating the listener also keeps the app's main process free to be evicted
            without killing wake-word detection.
        -->
        <service
            android:name=".voice.wakeword.WakeWordService"
            android:exported="false"
            android:process=":wakeword"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
